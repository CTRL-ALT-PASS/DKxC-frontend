{
  "expo": {
    "name": "Darcy's Kitchen x Cafe",
    "slug": "darcys-kitchen-cafe",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/darcys-logo-light.png",
    "scheme": "reactn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/darcys-logo-light.png",
        "monochromeImage": "./assets/images/darcys-logo-light.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sf3bctrlaltpass.darcyskitchencafe"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9db916f4-1623-436d-81b7-ceccaf043f62"
      }
    }
  }
}
